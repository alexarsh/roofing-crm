# Elephant MCP server (streamable HTTP). Property/permit data comes ONLY from here.
# Hosted Osceola server; for local development run the MCP on port 8877 and use
# http://localhost:8877/mcp instead.
ORACLE_MCP_URL=https://osceola-mcp.vercel.app/mcp
# Optional bearer token forwarded to the MCP server.
ORACLE_MCP_AUTH_TOKEN=
# County key served by the MCP query tables.
ORACLE_MCP_COUNTY=osceola

# CRM database (leads, activities, knowledge index). Local Docker Postgres by default;
# on Vercel this is the Neon-provided DATABASE_URL.
DATABASE_URL=postgres://postgres:crm@localhost:5433/postgres
# "pg" (node-postgres, local/dev) or "neon" (@neondatabase/serverless HTTP driver, Vercel).
DB_DRIVER=pg

# RAG assistant (Vercel AI SDK + @ai-sdk/anthropic). The UI shows a notice when absent.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5
